#include <windows.h>
#include "../../src/common/version.h"
VS_VERSION_INFO VERSIONINFO
FILEVERSION VER_FILE
PRODUCTVERSION VER_PRODUCT
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004b0"
        BEGIN
            VALUE "FileDescription", "px4_drv RTL-SDR USB diagnostic and I/Q capture"
            VALUE "FileVersion", VER_FILE_STR
            VALUE "InternalName", "rtlsdr_probe"
            VALUE "OriginalFilename", "rtlsdr_probe.exe"
            VALUE "ProductName", "px4_drv RTL-SDR tools"
            VALUE "ProductVersion", VER_PRODUCT_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0000, 1200
    END
END
